{
	"name": "otrion-chat",
	"displayName": "Otrion Chat",
	"description": "%description%",
	"version": "0.1.0",
	"publisher": "otrion",
	"license": "MIT",
	"engines": {
		"vscode": "^1.147.0"
	},
	"main": "./out/extension.js",
	"activationEvents": ["onStartupFinished"],
	"extensionKind": [
		"workspace"
	],
	"enabledApiProposals": ["resolvers"],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "Settings are available. Chat requires a trusted workspace."
		}
	},
	"devDependencies": {
		"@types/markdown-it": "^14.1.2",
		"diff": "8.0.3",
		"highlight.js": "^11.8.0",
		"markdown-it": "^14.2.0"
	},
	"contributes": {
		"customEditors": [
			{
				"viewType": "otrion.chat.session",
				"displayName": "Otrion Chat",
				"selector": [{ "filenamePattern": "otrion-session:/*" }]
			}
		],
		"viewsContainers": {
			"secondarySidebar": [
				{
					"id": "otrion-chat",
					"title": "Otrion Chat",
					"icon": "media/orbit.svg"
				}
			]
		},
		"views": {
			"otrion-chat": [
				{
					"type": "webview",
					"id": "otrion.chat",
					"name": "Agent Chat"
				}
			]
		},
		"commands": [
			{
				"command": "otrion.showThemeGuide",
				"category": "Otrion",
				"title": "Open Theme Guide"
			},
			{
				"command": "otrion.chat.open",
				"category": "Otrion",
				"title": "%openChat%"
			},
			{
				"command": "otrion.settings.open",
				"category": "Preferences",
				"title": "Otrion Settings"
			},
			{
				"command": "otrion.chat.new",
				"category": "Otrion",
				"title": "New Session",
				"icon": "$(add)"
			},
			{
				"command": "otrion.chat.history",
				"category": "Otrion",
				"title": "Session History",
				"icon": "$(history)"
			}
		],
		"configuration": {
			"title": "Otrion Chat",
			"properties": {
				"otrion.marketplace": {
					"type": "object",
					"scope": "application",
					"additionalProperties": false,
					"required": [
						"serviceUrl",
						"itemUrl"
					],
					"properties": {
						"serviceUrl": {
							"type": "string",
							"format": "uri",
							"pattern": "^https?://"
						},
						"itemUrl": {
							"type": "string",
							"format": "uri",
							"pattern": "^https?://"
						}
					},
					"default": {
						"serviceUrl": "https://open-vsx.org/vscode/gallery",
						"itemUrl": "https://open-vsx.org/vscode/item"
					},
					"description": "Extension marketplace endpoints. Reload the window after changing them."
				},
				"otrion.chat.enabledAgents": {
					"type": "array",
					"items": { "type": "string" },
					"default": [],
					"scope": "machine",
					"description": "Additional ACP agents enabled in Otrion Settings on this host."
				},
				"otrion.chat.usageProviders": {
					"type": "object",
					"additionalProperties": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
					"default": {},
					"scope": "machine",
					"markdownDescription": "Link an enabled agent to its billing provider configured in the CodexBar CLI on this host. For example, `{ \"antigravity\": \"antigravity\", \"qwen-code\": \"qwencloud\", \"goose\": \"openrouter\" }`. Linked accounts are labeled CodexBar in usage details."
				},
				"otrion.chat.agentPaths": {
					"type": "object",
					"additionalProperties": { "type": "string" },
					"default": {},
					"scope": "machine",
					"description": "Override an additional ACP agent executable by its catalog ID."
				},
				"otrion.chat.codexAcpPath": {
					"type": "string",
					"default": "codex-acp",
				"scope": "machine",
					"description": "%codexAcpPath%"
				},
				"otrion.chat.claudeAcpPath": {
					"type": "string",
					"default": "claude-agent-acp",
				"scope": "machine",
					"description": "Claude Code ACP executable name or absolute path."
				},
				"otrion.chat.codexAllowed": {
					"type": "boolean",
					"default": false,
				"scope": "machine",
					"description": "Allow Otrion to start Codex for chat."
				},
				"otrion.chat.claudeAllowed": {
					"type": "boolean",
					"default": false,
				"scope": "machine",
					"description": "Allow Otrion to start Claude Code for chat."
				}
			}
		},
		"menus": {
			"view/title": [
				{
					"command": "otrion.chat.new",
					"when": "view == otrion.chat",
					"group": "navigation@1"
				},
				{
					"command": "otrion.chat.history",
					"when": "view == otrion.chat",
					"group": "navigation@2"
				}
			]
		}
	}
}
